<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- On .NET, WebView2CompositionControl needs Windows 10 version 1809 (build 17763) or later. -->
    <TargetFrameworks>net10.0-windows10.0.17763.0;net48</TargetFrameworks>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(InstantReplayProject)" />
    <Content Include="index.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
