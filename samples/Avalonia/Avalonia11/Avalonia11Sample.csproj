<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net10.0-windows rather than net10.0 so that the net10.0-windows build of Instrumental.InstantReplay is used. -->
    <TargetFrameworks>net10.0-windows;net48</TargetFrameworks>
    <AvaloniaVersion>11.3.23</AvaloniaVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\AvaloniaSample.cs" Link="AvaloniaSample.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <ProjectReference Include="$(InstantReplayProject)" />
  </ItemGroup>

</Project>
