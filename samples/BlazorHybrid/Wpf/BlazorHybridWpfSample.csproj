<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The WPF BlazorWebView in .NET 10 needs Windows 10 version 1809 (build 17763) or later. -->
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="10.0.130" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(InstantReplayProject)" />
  </ItemGroup>

</Project>
