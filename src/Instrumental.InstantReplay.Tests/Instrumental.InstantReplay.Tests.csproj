<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net35;net48;net10.0-windows</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Missing reference to recommended package: "System.Memory" - but the tests also run on .NET 3.5, which System.Memory doesn't support -->
    <NoWarn>$(NoWarn);PInvoke009</NoWarn>

    <!-- Required so that the strong-named library can grant this assembly InternalsVisibleTo. -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\Instrumental.InstantReplay.snk</AssemblyOriginatorKeyFile>
    <!-- Shouldly isn't strong-name signed. That only matters for strong-name validation, which tests don't need. -->
    <NoWarn>$(NoWarn);CS8002</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net35'">
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep NUnit and Shouldly compatible with CLR 2.0 across all targets. -->
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.15.0" PrivateAssets="all" />
    <PackageReference Include="Shouldly" Version="2.8.3" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.367" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net35'">
    <PackageReference Include="NUnitLite" Version="3.14.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net35'">
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Instrumental.InstantReplay\Instrumental.InstantReplay.csproj" />
  </ItemGroup>

</Project>
