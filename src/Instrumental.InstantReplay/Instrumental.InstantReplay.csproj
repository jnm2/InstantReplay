<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net35;net48;net10.0-windows</TargetFrameworks>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\Instrumental.InstantReplay.snk</AssemblyOriginatorKeyFile>

    <Version>1.0.0</Version>
    <Authors>Joseph N. Musser II</Authors>
    <Copyright>Copyright © 2020–2026 Joseph N. Musser II</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/jnm2/InstantReplay</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jnm2/InstantReplay</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>animated GIF capture screenshot record windows desktop application UI diagnostic error crash report</PackageTags>
    <Description>Produces a GIF on demand of the last ten seconds of a Windows desktop app’s user interface. Useful for error reports.</Description>
    <EmbedAllSources>true</EmbedAllSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Missing reference to recommended package: "System.Memory" - but the code is written to run on .NET 3.5 anyway, which System.Memory doesn't support -->
    <NoWarn>$(NoWarn);PInvoke009</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DotNetAnalyzers.DocumentationAnalyzers" Version="1.0.0-beta.59" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.367" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Instrumental.InstantReplay.Tests" Key="" />
  </ItemGroup>

</Project>
